<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally transparent: makes the Android 12+ system splash show only
     the blue background, matching the first frame of the JS Splash.tsx exactly.
     The user sees one seamless blue screen before the JS letter animation starts. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>

<resources>

    <!-- Launch theme: shown by Android while the app cold-starts.
         installSplashScreen() in MainActivity switches to AppTheme immediately
         after the first frame, so this is only visible for ~100ms. -->
    <style name="BootTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zipto_splash_bg</item>
        <!-- Transparent icon: system splash shows only the blue background -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Base application theme used after the splash screen. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Neutral white window background. The cold-start splash uses the blue
             windowSplashScreenBackground above; keeping the post-splash window
             blue made it flash through during navigation.reset() between screens
             (e.g. FareEstimate → LiveTracking, where no scene is mounted for a
             frame). White removes that blue flash. -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/zipto_splash_bg</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

prepare_react_native_project!

target 'Zipto' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Modular headers required so FirebaseAuth (Swift) can import its ObjC
  # dependencies, which in turn lets Xcode generate FirebaseAuth-Swift.h,
  # and so that Xcode 26's explicit-modules build system can load FirebaseAuth
  # as a proper module (without this, FIRAuth appears as a forward declaration).
  pod 'GoogleUtilities',         :modular_headers => true
  pod 'FirebaseAuth',            :modular_headers => true
  pod 'FirebaseAuthInterop',     :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop',        :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Ensure FirebaseAuth compiles before RNFBMessaging so its Swift
    # compatibility header exists when the umbrella Firebase.h imports it.
    messaging_target    = installer.pods_project.targets.find { |t| t.name == 'RNFBMessaging' }
    firebase_auth_target = installer.pods_project.targets.find { |t| t.name == 'FirebaseAuth' }
    if messaging_target && firebase_auth_target
      messaging_target.add_dependency(firebase_auth_target)
    end

    # Firebase.h imports FirebaseAuth-Swift.h which Xcode generates during the
    # FirebaseAuth Swift build phase. We place this file in the pod's public
    # headers dir so the compiler finds it during ScanDependencies (before
    # FirebaseAuth compiles). If a prior build has already generated it we copy
    # the real file; otherwise we write a minimal stub that satisfies the
    # preprocessor (the real one is written by Xcode on the first full build).
    require 'fileutils'
    swift_header_dir  = "#{installer.sandbox.root}/Headers/Public/FirebaseAuth"
    swift_header_path = "#{swift_header_dir}/FirebaseAuth-Swift.h"
    FileUtils.mkdir_p(swift_header_dir)
    derived_data_root = File.expand_path("~/Library/Developer/Xcode/DerivedData")
    %w[Debug-iphoneos Release-iphoneos Debug-iphonesimulator Release-iphonesimulator].each do |config|
      Dir.glob("#{derived_data_root}/Zipto-*/Build/Intermediates.noindex/ArchiveIntermediates/Zipto/BuildProductsPath/#{config}/FirebaseAuth/Swift Compatibility Header/FirebaseAuth-Swift.h") +
      Dir.glob("#{derived_data_root}/Zipto-*/Index.noindex/Build/Products/#{config}/FirebaseAuth/Swift Compatibility Header/FirebaseAuth-Swift.h") +
      Dir.glob("#{derived_data_root}/Zipto-*/Build/Products/#{config}/FirebaseAuth/Swift Compatibility Header/FirebaseAuth-Swift.h")
    end
    generated_candidates = Dir.glob("#{derived_data_root}/Zipto-*/**/FirebaseAuth/Swift Compatibility Header/FirebaseAuth-Swift.h")
    real_header = generated_candidates.select { |p| File.exist?(p) && File.size(p) > 1000 }
                                      .max_by { |p| File.mtime(p) }
    if real_header
      FileUtils.cp(real_header, swift_header_path)
    else
      # No real header found yet — only write a placeholder if nothing useful is there.
      # (On the very first clean build the header won't exist; FirebaseAuth builds first
      # via add_dependency and generates the real file in DerivedData.)
      existing = File.exist?(swift_header_path) ? File.read(swift_header_path) : ''
      File.write(swift_header_path, "// placeholder\n") if existing.empty?
    end

    # Fix module name + umbrella clashes caused by RN 0.83.x pods sharing public-header
    # directories. Each pair below has two pods both declaring the same module name with
    # `umbrella header` pointing at the same directory, which LLVM rejects. The secondary
    # pod in each pair is rewritten to use a plain `header` declaration and a distinct
    # module name so the primary pod remains the sole umbrella owner of that directory.
    {
      "#{installer.sandbox.root}/Target Support Files/React-jsitooling/React-jsitooling.modulemap" =>
        "module react_jsitooling {\n  header \"React-jsitooling-umbrella.h\"\n\n  export *\n}\n",
      "#{installer.sandbox.root}/Target Support Files/React-RuntimeApple/React-RuntimeApple.modulemap" =>
        "module React_RuntimeApple {\n  header \"React-RuntimeApple-umbrella.h\"\n\n  export *\n}\n",
    }.each do |path, content|
      next unless File.exist?(path)
      File.write(path, content)
    end

    # RNFBMessaging+AppDelegate.m imports <Firebase/Firebase.h> which does include
    # <FirebaseAuth/FirebaseAuth.h> via __has_include — but Xcode 26 explicit-modules
    # doesn't process that transitive include before it scans the file, so FIRAuth
    # ends up as a bare @class forward declaration from FirebaseAuthInterop.
    # Patch the file to add the explicit import directly, bypassing module ordering.
    rnfb_appdelegate = File.expand_path(
      "../../node_modules/@react-native-firebase/messaging/ios/RNFBMessaging/RNFBMessaging+AppDelegate.m",
      installer.sandbox.root
    )
    if File.exist?(rnfb_appdelegate)
      src = File.read(rnfb_appdelegate)
      unless src.include?('#import <FirebaseAuth/FirebaseAuth.h>')
        patched = src.sub(
          '#import <Firebase/Firebase.h>',
          "#import <Firebase/Firebase.h>\n#import <FirebaseAuth/FirebaseAuth.h>"
        )
        File.write(rnfb_appdelegate, patched) if patched != src
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Fix fmt build issue
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        end

        # Ensure RNMapbox V11 Swift flags are present for Swift sources
        if ['rnmapbox-maps', 'MapboxMaps', 'MapboxCommon', 'MapboxCoreMaps', 'MapboxMobileEvents', 'Turf'].include?(target.name)
          config.build_settings['OTHER_SWIFT_FLAGS'] ||= ['$(inherited)', '-D RNMBX_11']
        end

        # Fix: FirebaseAuth-Swift.h not found in RNFBMessaging during ScanDependencies.
        if ['RNFBMessaging', 'RNFBAuth'].include?(target.name)
          config.build_settings['HEADER_SEARCH_PATHS'] = [
            '$(inherited)',
            '"${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAuth/Swift Compatibility Header"',
            '"${BUILT_PRODUCTS_DIR}/FirebaseAuth/Swift Compatibility Header"',
          ]
          config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end

        # Xcode 26: libtool fails for RNGestureHandler with explicit-modules object files.
        if target.name == 'RNGestureHandler'
          config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
    end
  end
end